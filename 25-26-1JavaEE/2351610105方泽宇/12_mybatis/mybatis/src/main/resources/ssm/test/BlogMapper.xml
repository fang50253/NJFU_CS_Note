<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ssm.test.BlogMapper">
    <resultMap id="BlogResultMap" type="ssm.test.Blog">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="author" column="author"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 新增博客 -->
    <insert id="insert" parameterType="ssm.test.Blog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO blog (title, content, author)
        VALUES (#{title}, #{content}, #{author})
    </insert>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="long" resultMap="BlogResultMap">
        SELECT * FROM blog WHERE id = #{id}
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultMap="BlogResultMap">
        SELECT * FROM blog ORDER BY create_time DESC
    </select>

    <!-- 动态更新 -->
    <update id="updateBySet" parameterType="ssm.test.Blog">
        UPDATE blog
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="author != null and author != ''">author = #{author},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除博客 -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM blog WHERE id = #{id}
    </delete>
</mapper>