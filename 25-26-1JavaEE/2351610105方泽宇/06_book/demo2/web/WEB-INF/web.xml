<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 1. 注册Servlet -->
    <servlet>
        <servlet-name>TempConvertServlet</servlet-name>
        <servlet-class>com.tempconvert.servlet.TempConvertServlet</servlet-class>
    </servlet>

    <!-- 2. 配置Servlet访问路径（与表单action一致） -->
    <servlet-mapping>
        <servlet-name>TempConvertServlet</servlet-name>
        <url-pattern>/tempconvert1</url-pattern>
    </servlet-mapping>

    <!-- 3. 设置默认首页（访问项目根路径自动打开输入页面） -->
    <welcome-file-list>
        <welcome-file>tempconvert0.html</welcome-file>
    </welcome-file-list>
</web-app>